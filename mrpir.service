[Unit]
Description=Motion Detection Service
After=network.target

[Service]
ExecStart=/home/pi/Projects/mrpir/venv/bin/python /home/pi/Projects/mrpir/main.py
WorkingDirectory=/home/pi/Projects/mrpir
EnvironmentFile=/home/pi/Projects/mrpir/.env
StandardOutput=inherit
StandardError=inherit
Restart=always
Type=notify
NotifyAccess=all
WatchdogSec=90s  # Optional: Set a watchdog timer if desired
# Environment=PYTHONUNBUFFERED=1
# Restart=on-failure
# RestartSec=5s
# StartLimitInterval=60s
# StartLimitBurst=3
# TimeoutSec=15

[Install]
WantedBy=default.target
