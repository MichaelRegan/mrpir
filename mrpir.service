[Unit]
Description=Motion Detection Service
After=network.target

[Service]
ExecStart=/home/pi/Projects/mrpir/venv/bin/python /home/pi/Projects/mrpir/src/main.py
WorkingDirectory=/home/pi/Projects/mrpir
EnvironmentFile=/home/pi/.mrpir/config/.env
Environment="PYTHONUNBUFFERED=1"
#StandardOutput=inherit
#StandardError=inherit
Restart=on-failure
Type=notify
ExecReload=/bin/kill -HUP $MAINPID
KillSignal=SIGTERM
NotifyAccess=all
WatchdogSec=60

[Install]
WantedBy=default.target
