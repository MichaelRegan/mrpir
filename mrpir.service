[Unit]
Description=Motion Detection Service
After=network.target

[Service]
ExecStart=/home/pi/Projects/mrpir/venv/bin/python /home/pi/Projects/mrpir/src/main.py
WorkingDirectory=/home/pi/Projects/mrpir
EnvironmentFile=/home/pi/.mrpir/config/.env
StandardOutput=inherit
StandardError=inherit
Restart=always
Type=notify
NotifyAccess=all
WatchdogSec=90s  # Optional: Set a watchdog timer if desired

[Install]
WantedBy=default.target
